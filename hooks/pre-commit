#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

# Redirect output to stderr.
exec 1>&2

apps=("$(git diff --cached --name-only --diff-filter=ACM | sed -n 's,metadata/\([^/]*\.yml\),\1,p')")

if [[ -n "${apps[*]}" ]]; then
  # shellcheck disable=SC2068
  for app in ${apps[@]}; do
    tools/verifyMeta.php -qf "$app"
  done
fi
